{
  "info": {
    "name": "Dobby Drive API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Full API test suite for Dobby Drive. Set the `base_url` variable to http://localhost:5000/api. After login, copy the token into the `token` variable."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api" },
    { "key": "token",    "value": "" },
    { "key": "folder_id","value": "" },
    { "key": "image_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "if (j.token) { pm.collectionVariables.set('token', j.token); }",
            "pm.test('Status 201', () => pm.response.to.have.status(201));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@dobbydrive.com\",\n  \"password\": \"test1234\"\n}" },
            "url": { "raw": "{{base_url}}/auth/signup", "host": ["{{base_url}}"], "path": ["auth","signup"] }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "if (j.token) { pm.collectionVariables.set('token', j.token); }",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has token', () => pm.expect(j.token).to.be.a('string'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"emailOrUsername\": \"test@dobbydrive.com\",\n  \"password\": \"test1234\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] }
          }
        },
        {
          "name": "Get My Profile",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has username', () => pm.expect(pm.response.json().username).to.be.a('string'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth","me"] }
          }
        }
      ]
    },
    {
      "name": "Folders",
      "item": [
        {
          "name": "List Root",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has folders array', () => pm.expect(pm.response.json().folders).to.be.an('array'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/folders", "host": ["{{base_url}}"], "path": ["folders"] }
          }
        },
        {
          "name": "Create Folder (root)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "if (j._id) { pm.collectionVariables.set('folder_id', j._id); }",
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Has _id', () => pm.expect(j._id).to.be.a('string'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Projects\"\n}" },
            "url": { "raw": "{{base_url}}/folders", "host": ["{{base_url}}"], "path": ["folders"] }
          }
        },
        {
          "name": "Create Nested Folder",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Campaigns\",\n  \"parent\": \"{{folder_id}}\"\n}" },
            "url": { "raw": "{{base_url}}/folders", "host": ["{{base_url}}"], "path": ["folders"] }
          }
        },
        {
          "name": "Get Folder Contents",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/folders/{{folder_id}}", "host": ["{{base_url}}"], "path": ["folders","{{folder_id}}"] }
          }
        },
        {
          "name": "Get Folder Size",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has size', () => pm.expect(pm.response.json().size).to.be.a('number'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/folders/size/{{folder_id}}", "host": ["{{base_url}}"], "path": ["folders","size","{{folder_id}}"] }
          }
        },
        {
          "name": "Delete Folder",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/folders/{{folder_id}}", "host": ["{{base_url}}"], "path": ["folders","{{folder_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Images",
      "item": [
        {
          "name": "Upload Image",
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "if (j._id) { pm.collectionVariables.set('image_id', j._id); }",
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Has _id', () => pm.expect(j._id).to.be.a('string'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file",  "description": "Select any image file from your machine" },
                { "key": "name",  "type": "text",  "value": "My Test Image" },
                { "key": "parent","type": "text",  "value": "{{folder_id}}", "description": "Optional: folder ID. Leave blank for root." }
              ]
            },
            "url": { "raw": "{{base_url}}/images/upload", "host": ["{{base_url}}"], "path": ["images","upload"] }
          }
        },
        {
          "name": "View Raw Image",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Is image', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/images/{{image_id}}/raw", "host": ["{{base_url}}"], "path": ["images","{{image_id}}","raw"] }
          }
        },
        {
          "name": "Delete Image",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/images/{{image_id}}", "host": ["{{base_url}}"], "path": ["images","{{image_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Server healthy', () => pm.response.to.have.status(200));"
      ], "type": "text/javascript" }}],
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:5000/health", "host": ["http://localhost:5000"], "path": ["health"] }
      }
    }
  ]
}
